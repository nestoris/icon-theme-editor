msgstr "Цель"

#: Status messages
msgid "OK"
msgstr "ОК"

msgid "Multiple contexts"
msgstr "Разные контексты"

msgid "Different DisplayName"
msgstr "Разные DisplayName"

msgid "Different symlink targets"
msgstr "Разные цели симлинков"

msgid "Symlinks only"
msgstr "Только симлинки"

