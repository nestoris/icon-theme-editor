msgstr "Нет"

#: Warning messages
msgid "Icon has different contexts!"
msgstr "Значок находится в разных контекстах!"

msgid "DisplayName differs between files!"
msgstr "DisplayName различается между файлами!"

#: File types
msgid "(file)"
msgstr "(файл)"

#: Dialog messages
msgid "Convert to symlink?"
msgstr "Преобразовать в симлинк?"

msgid "Convert to file?"
msgstr "Преобразовать в файл?"

msgid "File \"%s\" will be replaced with a symlink. Original file will be deleted."
msgstr "Файл \"%s\" будет заменен на симлинк. Исходный файл будет удален."

msgid "Symlink \"%s\" will be replaced with a copy of the file."
msgstr "Симлинк \"%s\" будет заменен на копию файла."

msgid "Delete %s?"
msgstr "Удалить %s?"

msgid "Will delete %s \"%s\". This cannot be undone."
msgstr "Будет удален %s \"%s\". Это действие нельзя отменить."

#: Dialog messages (new, unique)
msgid "Convert to symlink"
msgstr "Преобразовать в симлинк"

msgid "File \"%s\" will be replaced with a symlink. Enter the target path:"
msgstr "Файл \"%s\" будет заменен на симлинк. Введите путь к цели:"

#: Dialog buttons (new, unique)
msgid "Cancel"
msgstr "Отмена"

#: Symlink status tooltips (new, unique)
msgid "Enter a target path"
msgstr "Введите путь к цели"

msgid "Target is a symlink (indirect reference)"
msgstr "Цель является симлинком (косвенная ссылка)"

msgid "No changes to save"
msgstr "Нет изменений для сохранения"

msgid "Saved successfully"
msgstr "Успешно сохранено"

msgid "Enter target path..."
msgstr "Введите путь к цели..."

#: Error messages
msgid "Theme file does not exist"
msgstr "Файл темы не существует"

msgid "Directory does not contain index.theme"
msgstr "Директория не содержит index.theme"

msgid "Invalid theme file"
msgstr "Неверный файл темы"

msgid "Error loading theme"
msgstr "Ошибка загрузки темы"

msgid "Could not read index.theme"
msgstr "Не удалось прочитать index.theme"

msgid "Error scanning"
msgstr "Ошибка сканирования"

msgid "Symlink target not found"
msgstr "Не найдена цель симлинка"

msgid "Target file does not exist"
msgstr "Целевой файл не существует"

msgid "Could not open image"
msgstr "Не удалось открыть изображение"

msgid "File does not exist"
msgstr "Файл не существует"

msgid "Error deleting file"
msgstr "Ошибка при удалении файла"

msgid "Error saving symlink"
msgstr "Ошибка сохранения симлинка"

msgid "Save error"
msgstr "Ошибка сохранения"

msgid "Symlink target cannot be empty"
msgstr "Цель симлинка не может быть пустой"

msgid "Target not specified"
msgstr "Цель не указана"

msgid "Target is symlink"
msgstr "Цель является симлинком"

msgid "File exists"
msgstr "Файл существует"

msgid "Unknown file type"
msgstr "Неизвестный тип файла"

msgid "Error checking file"
msgstr "Ошибка проверки файла"

msgid "Symlink target updated"
msgstr "Цель симлинка обновлена"

#: Status
msgid "Loaded %d icons"
msgstr "Загружено значков: %d"

msgid "File converted to symlink: %s → %s"
msgstr "Файл преобразован в симлинк: %s → %s"

msgid "Symlink converted to file: %s"
msgstr "Симлинк преобразован в файл: %s"

msgid "Deleted %s: %s"
msgstr "Удален %s: %s"

msgid "DisplayName saved in %d files"
msgstr "DisplayName сохранен в %d файлах"

#: File preview
msgid "File:"
msgstr "Файл:"

msgid "Type:"
msgstr "Тип:"

msgid "Dimensions:"
msgstr "Размеры:"

msgid "File size:"
msgstr "Размер файла:"

msgid "Modified:"
msgstr "Изменен:"

msgid "Symbolic link"
msgstr "Символическая ссылка"

msgid "(does not exist)"
msgstr "(не существует)"

msgid "(exists)"
msgstr "(существует)"

msgid "Could not open file manager"
msgstr "Не удалось открыть файловый менеджер"

msgid "Could not open directory"
msgstr "Не удалось открыть директорию"

msgid "Error opening file manager"
msgstr "Ошибка при открытии файлового менеджера"

msgid "Load error"
msgstr "Ошибка загрузки"

msgid "Could not get dimensions"
msgstr "Не удалось получить размеры"

msgid "Error converting to symlink: %s"
msgstr "Ошибка преобразования в симлинк: %s"

msgid "Error converting to file: %s"
msgstr "Ошибка преобразования в файл: %s"

#: Properties window - title
msgid "Properties: %s"
msgstr "Свойства: %s"

#: Properties window - summary in header
msgid "%d files, %d symlinks, %d contexts"
msgstr "Файлов: %d, симлинков: %d, контекстов: %d"

#: Properties window - notebook tooltip
msgid "One tab per icon context found in index.theme. Operations apply only to the current tab."
msgstr "По одной вкладке на каждый контекст значка из index.theme. Операции применяются только к текущей вкладке."

#: Properties window - section labels
msgid "Files in this context"
msgstr "Файлы в этом контексте"

msgid "Operations"
msgstr "Операции"

msgid "Referenced by"
msgstr "Ссылаются на"

#: Properties window - tooltips on section labels
msgid "Physical files and symlinks of this icon in directories belonging to the selected context."
msgstr "Физические файлы и симлинки этого значка в каталогах выбранного контекста."

msgid "All symlinks across the whole theme that point to physical files listed above. Built at window open; use Refresh to rebuild."
msgstr "Все симлинки во всей теме, указывающие на перечисленные выше физические файлы. Строится при открытии окна; для пересборки нажмите «Обновить»."

#: Properties window - columns
msgid "Path"
msgstr "Путь"

msgid "Physical file"
msgstr "Физический файл"

msgid "Referrer"
msgstr "Ссылающийся"

msgid "Icon"
msgstr "Значок"

#: Properties window - status values in file table
msgid "Broken"
msgstr "Битая"

msgid "Chain"
msgstr "Цепочка"

#: Properties window - file type values (lowercase, in table)
msgid "symlink"
msgstr "симлинк"

msgid "file"
msgstr "файл"

#: Properties window - buttons
msgid "Close"
msgstr "Закрыть"

msgid "Master file..."
msgstr "Мастер-файл..."

msgid "All to files"
msgstr "Всё в файлы"

msgid "Unchain"
msgstr "Развернуть цепочки"

msgid "Remove broken"
msgstr "Удалить битые"

#: Properties window - button tooltips
msgid "Re-read files and symlinks of this icon from disk, then rebuild the referenced-by index."
msgstr "Перечитать файлы и симлинки этого значка с диска и перестроить индекс обратных ссылок."

msgid "Close this window. Any changes already applied stay on disk."
msgstr "Закрыть окно. Уже применённые изменения остаются на диске."

msgid "Choose one physical file as the master. All other files and symlinks in this context will be re-pointed to it."
msgstr "Выбрать один физический файл мастером. Все остальные файлы и симлинки в этом контексте будут указывать на него."

msgid "Replace every symlink in this context with a physical copy of its target. The symlinks are removed and real files are written."
msgstr "Заменить каждый симлинк в этом контексте физической копией его цели. Симлинки удаляются, вместо них записываются реальные файлы."

msgid "For every symlink that points to another symlink, re-target it directly to the final physical file."
msgstr "Для каждого симлинка, указывающего на другой симлинк, перенаправить его напрямую на конечный физический файл."

msgid "Delete symlinks in this context whose target file no longer exists. Physical files are never touched."
msgstr "Удалить симлинки в этом контексте, цель которых больше не существует. Физические файлы не затрагиваются."

#: Master file dialog
msgid "Choose master file"
msgstr "Выбор мастер-файла"

msgid "Choose a file to become the master. Other files in this context will become symlinks to it."
msgstr "Выберите файл, который станет мастером. Остальные файлы в этом контексте станут симлинками на него."

msgid "No physical files in this context. Cannot choose a master."
msgstr "В этом контексте нет физических файлов. Нельзя выбрать мастер."

#: All to files
msgid "Convert %d symlinks to physical files?"
msgstr "Преобразовать %d симлинков в физические файлы?"

msgid "Each symlink will be replaced with a copy of its target file."
msgstr "Каждый симлинк будет заменён копией своего целевого файла."

msgid "No symlinks in this context."
msgstr "В этом контексте нет симлинков."

#: Unchain
msgid "Fix %d symlink chains?"
msgstr "Развернуть %d цепочек симлинков?"

msgid "Each symlink pointing to another symlink will be re-targeted directly to the final file."
msgstr "Каждый симлинк, указывающий на другой симлинк, будет перенаправлен напрямую на конечный файл."

msgid "No symlink chains found."
msgstr "Цепочек симлинков не найдено."

#: Remove broken
msgid "Delete %d broken symlinks?"
msgstr "Удалить %d битых симлинков?"

msgid "No broken symlinks in this context."
msgstr "В этом контексте нет битых симлинков."

#: Generic errors header
msgid "Errors:"
msgstr "Ошибки:"

#: Column headers
msgid "Size"
msgstr "Размер"

msgid "Type"
msgstr "Тип"